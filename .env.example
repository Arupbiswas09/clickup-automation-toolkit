# ClickUp API Configuration
# Get your API key from: https://app.clickup.com/settings/apps
CLICKUP_API_KEY=your_clickup_api_key_here

# Your ClickUp Team ID
# Found in your ClickUp URL or via API
CLICKUP_TEAM_ID=your_team_id_here

# Default List ID for task creation
# Found in list URL or via API
CLICKUP_LIST_ID=your_default_list_id_here

# Default assignee user ID (optional)
# Found in user profile or via API
CLICKUP_DEFAULT_ASSIGNEE=your_default_user_id_here

# Optional: Custom configuration
NODE_ENV=production
DEBUG=false

# Optional: Notification settings
ENABLE_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: Rate limiting
API_RATE_LIMIT=100
API_TIMEOUT=5000